modules = ["nodejs-20", "web", "postgresql-16", "python-base-3.13"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["gtk4", "pango", "harfbuzz", "glib", "cairo", "gdk-pixbuf", "gst_all_1.gstreamer", "gst_all_1.gst-plugins-base", "gst_all_1.gst-plugins-good", "gst_all_1.gst-plugins-bad", "nss", "atk", "at-spi2-atk", "dbus", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXfixes", "xorg.libXrandr", "mesa", "libxkbcommon", "alsa-lib", "icu", "gcc", "libxml2", "sqlite", "libxslt", "lcms2", "libevent", "libopus", "flite", "libwebp", "libavif", "libjpeg", "enchant", "libsecret", "hyphen", "libglvnd", "x264", "icu74", "libepoxy", "libjpeg_turbo", "gst_all_1.gst-libav", "libwpe", "libsoup_3", "libjxl", "libbacktrace", "libmanette"]

[[ports]]
localPort = 5000
externalPort = 80

[env]
PORT = "5000"

[deployment]
deploymentTarget = "autoscale"
run = ["node", "./dist/index.cjs"]
build = ["npm", "run", "build"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[userenv]

[userenv.shared]
LMS_OTP_WEBHOOK_URL = "https://n8n.aromacafeinstitute.in/webhook/aroma-whatsapp"

[postMerge]
path = "script/post-merge.sh"
timeoutMs = 180000

[objectStorage]
defaultBucketID = "replit-objstore-5b0d8081-ed0f-4a5d-9348-39d6772a396a"
